---
// src/components/docs/ProgressBar.astro

// This component uses vanilla JS to track scroll progress and animate a sleek
// fixed progress bar at the very top of the window.
---

<div id="setu-progress-container">
  <div id="setu-progress-bar"></div>
</div>

<script>
  function updateProgress() {
    const scrollPx =
      document.documentElement.scrollTop || document.body.scrollTop;
    const winHeightPx =
      document.documentElement.scrollHeight -
      document.documentElement.clientHeight;
    const scrolled = `${(scrollPx / winHeightPx) * 100}%`;

    const bar = document.getElementById("setu-progress-bar");
    if (bar) {
      if (
        document.documentElement.scrollHeight <=
        document.documentElement.clientHeight
      ) {
        // Hide if page is non-scrollable
        bar.style.width = "0%";
      } else {
        bar.style.width = scrolled;
      }
    }
  }

  // Set up listeners. We use Astro dev-friendly view transition events + standard scroll.
  window.addEventListener("scroll", updateProgress);
  window.addEventListener("resize", updateProgress);

  // Re-run on Astro view transitions
  document.addEventListener("astro:page-load", updateProgress);

  // Initial run
  updateProgress();
</script>

<style>
  #setu-progress-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 9999;
    pointer-events: none; /* Let clicks pass through */
    background: transparent;
  }

  #setu-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #6366f1, #8b5cf6, #06b6d4);
    background-size: 200% auto;
    box-shadow:
      0 0 10px rgba(99, 102, 241, 0.6),
      0 0 4px rgba(6, 182, 212, 0.4);
    border-radius: 0 2px 2px 0;
    transition: width 0.1s ease-out;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    to {
      background-position: 200% center;
    }
  }
</style>
