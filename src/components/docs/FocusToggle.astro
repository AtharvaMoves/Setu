---
// src/components/docs/FocusToggle.astro
---

<button
  id="focus-toggle"
  class="focus-btn group"
  aria-label="Toggle Focus Mode"
  title="Toggle Focus Mode (.)"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="expand-icon"
    ><path
      d="m21 21-6-6m6 6v-4.8m0 4.8h-4.8M3 21l6-6m-6 6v-4.8m0 4.8h4.8M3 3l6 6M3 3v4.8M3 3h4.8m13.2 0-6 6M21 3v4.8M21 3h-4.8"
    ></path></svg
  >
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="collapse-icon"
    ><path d="m4 14 5-5 5 5"></path><path d="m4 10 5 5 5-5"></path></svg
  >
</button>

<script>
  // Initialization of the toggle
  const initFocusToggle = () => {
    const btn = document.getElementById("focus-toggle");
    if (!btn) return;

    btn.addEventListener("click", () => {
      document.documentElement.classList.toggle("focus-mode");
    });
  };

  // Run on first load and after Astro View Transitions
  initFocusToggle();
  document.addEventListener("astro:page-load", initFocusToggle);
</script>

<style>
  .focus-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 0.5rem;
    background: transparent;
    border: 1px solid transparent;
    color: var(--foreground);
    opacity: 0.7;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .focus-btn:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.08);
    transform: scale(1.05);
  }

  .focus-btn:active {
    transform: scale(0.95);
  }

  .focus-btn .collapse-icon {
    display: none;
  }

  /* When focus mode is active, swap icons */
  :global(html.focus-mode) .focus-btn .expand-icon {
    display: none;
  }

  :global(html.focus-mode) .focus-btn .collapse-icon {
    display: block;
  }
</style>
